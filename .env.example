OPENAI_API_KEY=sk-...
# スライド画像生成モデル
SLIDE_IMAGE_MODEL=gpt-image-2
# 本文をキーワードに要約するテキストモデル
SLIDE_TEXT_MODEL=gpt-6-astra
# 要約時の推論の深さ（low / medium / high / xhigh / max）
# gpt-6-astra は minimal / none を受け付けないので、指定しても low に丸められる
SLIDE_TEXT_EFFORT=low
# 出力先ルート（省略時: iCloud Drive の Downloads）
# プロジェクトごとに OUTPUT_ROOT/<プロジェクト名>/ が作られ、PNG と PPTX が保存される
OUTPUT_ROOT=/Users/yourname/Library/Mobile Documents/com~apple~CloudDocs/Downloads
# 購入済みの医用画像ライブラリ（解剖図を素材として選ぶ元）。省略時は ~/src/medical-image-library
# 見つからない場合はライブラリ機能が出ないだけで、アプリは通常どおり動く
MEDICAL_IMAGE_LIBRARY=/Users/yourname/src/medical-image-library
